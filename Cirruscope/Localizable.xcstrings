    "The address contains characters that are not allowed in a web address. Please check the address and try again." : {
      "comment" : "Error shown when the entered server address contains control characters.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse enthält Zeichen, die in einer Webadresse nicht erlaubt sind. Bitte überprüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección contiene caracteres que no se permiten en una dirección web. Comprueba la dirección y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse contient des caractères qui ne sont pas autorisés dans une adresse web. Veuillez vérifier l'adresse et réessayer."
          }
        }
      }
    },
    "The address is missing a server name. Please enter an address such as https://cloud.example.com." : {
      "comment" : "Error shown when the entered server address names no server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Adresse fehlt der Servername. Bitte geben Sie eine Adresse wie https://cloud.example.com ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el nombre del servidor en la dirección. Introduce una dirección como https://cloud.example.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom du serveur est absent de l'adresse. Veuillez saisir une adresse telle que https://cloud.example.com."
          }
        }
      }
    },
    "The address is too long. Please enter only the address of your Nextcloud server." : {
      "comment" : "Error shown when the entered server address is longer than any address could reasonably be.",
      "localizations" : {
