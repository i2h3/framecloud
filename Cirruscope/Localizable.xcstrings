{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” already uses this shortcut." : {
      "comment" : "Tooltip on the shortcut recorder explaining what the just-rejected shortcut is already used by: one of Cirruscope's own menu items, or another Nextcloud server app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verwendet diese Tastenkombination bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya usa este atajo de teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” utilise déjà ce raccourci clavier."
          }
        }
      }
    },
    "“%@” is not a valid server name. Please check the address and try again." : {
      "comment" : "Error shown when the server name in the entered address cannot name a server; the placeholder is that name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ist kein gültiger Servername. Bitte überprüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un nombre de servidor válido. Comprueba la dirección y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” n'est pas un nom de serveur valide. Veuillez vérifier l'adresse et réessayer."
          }
        }
      }
    },
    "“%@” is not a valid URL. Please check the address and try again." : {
      "comment" : "Alert message shown when the entered server address is not a valid URL; the placeholder is the address the user typed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ist keine gültige URL. Bitte überprüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es una URL válida. Comprueba la dirección y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” n'est pas une URL valide. Veuillez vérifier l'adresse et réessayer."
          }
        }
      }
    },
    "“%lld” is not a valid port number. Please enter a port between 1 and 65535." : {
      "comment" : "Error shown when the port in the entered server address is out of range; the placeholder is that port.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” ist keine gültige Portnummer. Bitte geben Sie einen Port zwischen 1 und 65535 ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” no es un número de puerto válido. Introduce un puerto entre 1 y 65535."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” n'est pas un numéro de port valide. Veuillez saisir un port compris entre 1 et 65535."
          }
        }
      }
    },
    "%@" : {
      "comment" : "The title of a Spotlight result for a Nextcloud server app. The argument is the app's name.",
