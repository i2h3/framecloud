<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroupIdentifier</key>
	<string>group.$(CIRRUSCOPE_BASE_BUNDLE_IDENTIFIER)</string>
    <key>KeychainServiceIdentifier</key>
    <string>$(CIRRUSCOPE_KEYCHAIN_SERVICE_IDENTIFIER)</string>
	<key>MinimumSupportedNextcloudMajorVersion</key>
    <string>$(CIRRUSCOPE_MINIMUM_SUPPORTED_NEXTCLOUD_MAJOR_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>PrivacyPolicy</key>
	<string>$(CIRRUSCOPE_PRIVACY_POLICY_URL)</string>
	<key>SupportURL</key>
	<string>$(CIRRUSCOPE_SUPPORT_URL)</string>
</dict>
</plist>
