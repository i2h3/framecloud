{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” is not a valid server name. Please check the address and try again." : {
      "comment" : "Error shown when the server name in the entered address cannot name a server; the placeholder is that name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ist kein gültiger Servername. Bitte überprüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un nombre de servidor válido. Comprueba la dirección y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” n'est pas un nom de serveur valide. Veuillez vérifier l'adresse et réessayer."
          }
        }
      }
    },
    "“%@” is not a valid URL. Please check the address and try again." : {
      "comment" : "Alert message shown when the entered server address is not a valid URL; the placeholder is the address the user typed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ist keine gültige URL. Bitte überprüfen Sie die Adresse und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es una URL válida. Comprueba la dirección y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” n'est pas une URL valide. Veuillez vérifier l'adresse et réessayer."
          }
        }
      }
    },
    "“%lld” is not a valid port number. Please enter a port between 1 and 65535." : {
      "comment" : "Error shown when the port in the entered server address is out of range; the placeholder is that port.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” ist keine gültige Portnummer. Bitte geben Sie einen Port zwischen 1 und 65535 ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” no es un número de puerto válido. Introduce un puerto entre 1 y 65535."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%lld” n'est pas un numéro de port valide. Veuillez saisir un port compris entre 1 et 65535."
          }
        }
      }
    },
    "Account" : {
      "comment" : "A menu item that opens a menu when tapped.",
      "isCommentAutoGenerated" : true
    },
    "Assuming HTTPS for a secure connection unless specified differently." : {
      "comment" : "Caption under the server address field on the iOS sign-in screen, naming the HTTPS default the app applies to an address entered without a scheme of its own.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS wird für eine sichere Verbindung angenommen, sofern nicht anders angegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se asume HTTPS para una conexión segura, salvo que se indique lo contrario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS est utilisé pour une connexion sécurisée, sauf indication contraire."
          }
        }
      }
    },
    "Cirruscope can only connect to a Nextcloud server over HTTP or HTTPS, not “%@”." : {
      "comment" : "Error shown when the entered server address uses a scheme other than HTTP or HTTPS; the placeholder is that scheme.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope kann sich nur über HTTP oder HTTPS mit einem Nextcloud-Server verbinden, nicht über “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope solo puede conectarse a un servidor Nextcloud mediante HTTP o HTTPS, no mediante “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope ne peut se connecter à un serveur Nextcloud qu'en HTTP ou HTTPS, pas en “%@”."
          }
        }
      }
    },
    "Cirruscope requires Nextcloud server version %lld or later. The server at “%@” is running version %@." : {
      "comment" : "Alert message shown when the server's Nextcloud version is too old; placeholders are the minimum supported major version, the server address, and the server's version.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope erfordert Nextcloud-Serverversion %lld oder neuer. Der Server unter “%@” verwendet Version %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope requiere la versión %lld o posterior del servidor Nextcloud. El servidor en “%@” está ejecutando la versión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirruscope requiert la version %lld ou ultérieure du serveur Nextcloud. Le serveur à l'adresse “%@” exécute la version %@."
          }
        }
      }
    },
